{
  "dashboard": {
    "uid": "backend-monitoring",
    "id": null,
    "title": "Backend Spring Boot - Monitoring",
    "tags": ["backend", "spring-boot", "java", "jvm", "monitoring"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 0,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
        "type": "stat",
        "title": "Backend Status",
        "targets": [
          {
            "expr": "up{job=\"si-releves-backend\"}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "red"},
                {"value": 1, "color": "green"}
              ]
            },
            "mappings": [
              {
                "type": "value",
                "options": {
                  "0": {"text": "DOWN", "color": "red"},
                  "1": {"text": "UP", "color": "green"}
                }
              }
            ]
          }
        }
      },
      {
        "id": 2,
        "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0},
        "type": "stat",
        "title": "JVM Uptime",
        "targets": [
          {
            "expr": "jvm_uptime_seconds{job=\"si-releves-backend\"} / 3600",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "hours",
            "decimals": 2
          }
        }
      },
      {
        "id": 3,
        "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
        "type": "stat",
        "title": "HTTP Requests Total",
        "targets": [
          {
            "expr": "http_server_requests_seconds_count{job=\"si-releves-backend\"}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        }
      },
      {
        "id": 4,
        "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
        "type": "stat",
        "title": "Active HTTP Connections",
        "targets": [
          {
            "expr": "tomcat_threads_current_threads{job=\"si-releves-backend\"}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        }
      },
      {
        "id": 5,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "type": "timeseries",
        "title": "HTTP Request Rate (req/s)",
        "targets": [
          {
            "expr": "rate(http_server_requests_seconds_count{job=\"si-releves-backend\"}[5m])",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "min": 0
          }
        }
      },
      {
        "id": 6,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "type": "timeseries",
        "title": "HTTP Response Time (ms)",
        "targets": [
          {
            "expr": "rate(http_server_requests_seconds_sum{job=\"si-releves-backend\"}[5m]) / rate(http_server_requests_seconds_count{job=\"si-releves-backend\"}[5m]) * 1000",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "min": 0
          }
        }
      },
      {
        "id": 7,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "type": "timeseries",
        "title": "JVM Memory Usage (MB)",
        "targets": [
          {
            "expr": "jvm_memory_used_bytes{job=\"si-releves-backend\", area=\"heap\"} / 1024 / 1024",
            "legendFormat": "Heap Used",
            "refId": "A"
          },
          {
            "expr": "jvm_memory_max_bytes{job=\"si-releves-backend\", area=\"heap\"} / 1024 / 1024",
            "legendFormat": "Heap Max",
            "refId": "B"
          },
          {
            "expr": "jvm_memory_committed_bytes{job=\"si-releves-backend\", area=\"heap\"} / 1024 / 1024",
            "legendFormat": "Heap Committed",
            "refId": "C"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "MB",
            "min": 0
          }
        }
      },
      {
        "id": 8,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
        "type": "timeseries",
        "title": "JVM GC Pause Time (ms)",
        "targets": [
          {
            "expr": "rate(jvm_gc_pause_seconds_sum{job=\"si-releves-backend\"}[5m]) * 1000",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "min": 0
          }
        }
      },
      {
        "id": 9,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
        "type": "timeseries",
        "title": "HTTP Status Codes",
        "targets": [
          {
            "expr": "rate(http_server_requests_seconds_count{job=\"si-releves-backend\", status=~\"2..\"}[5m])",
            "legendFormat": "2xx Success",
            "refId": "A"
          },
          {
            "expr": "rate(http_server_requests_seconds_count{job=\"si-releves-backend\", status=~\"4..\"}[5m])",
            "legendFormat": "4xx Client Error",
            "refId": "B"
          },
          {
            "expr": "rate(http_server_requests_seconds_count{job=\"si-releves-backend\", status=~\"5..\"}[5m])",
            "legendFormat": "5xx Server Error",
            "refId": "C"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "min": 0
          }
        }
      },
      {
        "id": 10,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
        "type": "timeseries",
        "title": "Container CPU Usage (%)",
        "targets": [
          {
            "expr": "rate(container_cpu_usage_seconds_total{name=\"si-releves-backend\"}[5m]) * 100",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"},
                {"value": 50, "color": "yellow"},
                {"value": 80, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 11,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
        "type": "timeseries",
        "title": "Container Memory Usage (MB)",
        "targets": [
          {
            "expr": "container_memory_usage_bytes{name=\"si-releves-backend\"} / 1024 / 1024",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "MB",
            "min": 0
          }
        }
      },
      {
        "id": 12,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
        "type": "table",
        "title": "HTTP Endpoints Performance",
        "targets": [
          {
            "expr": "topk(10, rate(http_server_requests_seconds_count{job=\"si-releves-backend\"}[5m]))",
            "format": "table",
            "instant": true,
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "align": "auto"
            }
          }
        }
      }
    ]
  }
}

