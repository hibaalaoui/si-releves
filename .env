# ============================================
# Configuration Docker Compose
# ============================================
COMPOSE_PROJECT_NAME=si-releves-prod

# ============================================
# Configuration MySQL Database
# ============================================
MYSQL_ROOT_PASSWORD=root 
MYSQL_DATABASE=si_releves
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_PORT=3306

# ============================================
# Configuration Backend Spring Boot
# ============================================
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=production

# ============================================
# Configuration Frontend
# ============================================
FRONTEND_PORT=80

# ============================================
# Configuration JWT Security
# ============================================
# Générer une clé secrète forte (minimum 256 bits)
# Exemple: openssl rand -base64 32
JWT_SECRET=eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhYmRlbG91YWhlZCIsImlhdCI6MTY5...

JWT_EXPIRATION=1800000

# ============================================
# Configuration CORS
# ============================================
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1,http://127.0.0.1:80

# ============================================
# Configuration Monitoring
# ============================================
PROMETHEUS_PORT=9090

# ============================================
# Configuration AI Services
# ============================================
PREDICTION_INTERVAL=60
SCALE_UP_THRESHOLD=80
SCALE_DOWN_THRESHOLD=30
MIN_INSTANCES=1
MAX_INSTANCES=5
CHECK_INTERVAL=30

# ============================================
# Instructions
# ============================================
# 1. Copiez ce fichier vers .env
# 2. Modifiez tous les mots de passe et secrets
# 3. Ne commitez JAMAIS le fichier .env dans Git
# 4. Utilisez des mots de passe forts (minimum 16 caractères)
